# Dependency Directories
**/node_modules/
node_modules/

# Meteor Specifics
# Note: Meteor automatically creates a .gitignore in .meteor/ to ignore the local folder,
# but we explicitly ignore the build and local folders here for safety.
**/.meteor/local/
**/_build/
_build/
**/build-assets/
**/build-chunks/
output/

# Build and Production Artifacts
**/dist/
**/build/
**/out/

# Rsdoctor reports
**/.rsdoctor/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage directories
**/coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
